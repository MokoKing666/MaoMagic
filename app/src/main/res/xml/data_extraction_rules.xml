<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 数据提取规则：排除 API Key 等敏感数据 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="magic_secure_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="magic_secure_keys.xml" />
    </device-transfer>
</data-extraction-rules>
